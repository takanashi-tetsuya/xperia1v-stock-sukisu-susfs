+# Use the pinned local Git history with the upstream version formula.
+# Never query a moving remote branch or fall back to a compatibility number.
+LOCAL_COUNT     := $(git_commit_count)
+ifeq ($(strip $(LOCAL_COUNT)),)
+$(error SukiSU Git history is required to generate the kernel version)
+endif
+KSU_VERSION     := $(shell expr $(VERSION_BASE) + $(LOCAL_COUNT) - $(VERSION_OFFSET))
+VERSION_TAG     := 4.2.0
+KSU_VERSION_FULL := v$(VERSION_TAG)-$(git_short_sha)+local-susfs2.3@xperia-20260920
 $(info -- $(REPO_NAME) version: $(KSU_VERSION) [$(KSU_VERSION_FULL)])
 
 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
